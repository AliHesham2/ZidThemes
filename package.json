{
  "name": "zidmirvela",
  "version": "1.0.0",
  "description": "Zid Vitrin storefront theme for Mirvela",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:css": "npx @tailwindcss/cli -i assets/tailwindcss.css -o assets/styles.css --watch",
    "dev:js": "vite build --watch",
    "build": "npm-run-all build:*",
    "build:css": "npx @tailwindcss/cli -i assets/tailwindcss.css -o assets/styles.css --minify",
    "build:js": "cross-env NODE_ENV=production ENTRY=main vite build && cross-env NODE_ENV=production ENTRY=cart vite build",
    "build:dev": "cross-env ENTRY=main vite build && cross-env ENTRY=cart vite build",
    "format": "prettier --write \"**/*.{css,js,json,jinja,html}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "@tailwindcss/typography": "^0.5.19",
    "cross-env": "^7.0.3",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "prettier-plugin-jinja-template": "^2.1.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.13",
    "vite": "^7.3.0"
  }
}
