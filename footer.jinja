{# Footer Component — Mirvela Theme #}
<footer class="site-footer bg-secondary/30 text-foreground border-border mt-auto border-t">
  <div class="footer__inner theme-container">
    <!-- Top Footer Grid (3 Columns: Brand 2fr · Quick Links 1fr · Customer Service 1fr) -->
    <div
      class="grid grid-cols-1 items-start gap-8 pt-14 pb-12 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr] lg:gap-[0_72px]"
    >
      <!-- Brand Column (2fr) -->
      <div class="footer__brand space-y-4">
        <div class="footer__logo-wrap">
          {% set logo = settings.header_logo %}
          {% if logo %}
            <img
              src="{{ image_url(logo, w=240, f='auto', q=85) }}"
              alt="{{ store.name }}"
              width="140"
              height="48"
              class="h-auto max-h-12 w-auto object-contain"
            />
          {% else %}
            <span class="footer__brand-name font-heading text-foreground text-2xl font-bold"
              >{{ store.name }}</span
            >
          {% endif %}
        </div>

        <!-- Small Deco Rule Under Brand -->
        <div class="footer__deco-rule bg-border/60 my-3 h-[1px] w-10"></div>

        {% set brand_description = store.settings.branding.description %}
        {% if brand_description %}
          <p class="footer__tagline text-muted max-w-[260px] text-sm leading-relaxed">
            {{ brand_description }}
          </p>
        {% endif %}

        {% if safeget(settings, "footer_show_social_links", true) %}
          {% include 'components/layout/social_links.jinja' %}
        {% endif %}
      </div>

      <!-- Quick Links Column (1fr) -->
      <div class="footer__nav space-y-4">
        <h3 class="footer__nav-title font-heading text-foreground m-0 text-xs font-bold">
          {{ _("Quick Links") }}
        </h3>
        <ul class="footer__nav-list m-0 list-none space-y-3 p-0 text-sm">
          <li>
            <a
              href="{{ url_for('home') }}"
              class="footer__nav-link text-foreground/80 hover:text-primary inline-block transition-all duration-150"
            >
              {{ _("Home") }}
            </a>
          </li>
          <li>
            <a
              href="{{ url_for('list_products') }}"
              class="footer__nav-link text-foreground/80 hover:text-primary inline-block transition-all duration-150"
            >
              {{ _("All Products") }}
            </a>
          </li>
          <li>
            <a
              href="{{ url_for('list_categories') }}"
              class="footer__nav-link text-foreground/80 hover:text-primary inline-block transition-all duration-150"
            >
              {{ _("Categories") }}
            </a>
          </li>
          <li>
            <a
              href="{{ url_for('list_blogs') }}"
              class="footer__nav-link text-foreground/80 hover:text-primary inline-block transition-all duration-150"
            >
              {{ _("Blog") }}
            </a>
          </li>
        </ul>
      </div>

      <!-- Customer Service Column (1fr) -->
      <div class="footer__nav space-y-4">
        <h3 class="footer__nav-title font-heading text-foreground m-0 text-xs font-bold">
          {{ _("Customer Service") }}
        </h3>
        <ul class="footer__nav-list m-0 list-none space-y-3 p-0 text-sm">
          <li>
            <a
              href="{{ url_for('faqs') }}"
              class="footer__nav-link text-foreground/80 hover:text-primary inline-block transition-all duration-150"
            >
              {{ _("FAQs") }}
            </a>
          </li>
          <li>
            <a
              href="{{ url_for('shipping_payment') }}"
              class="footer__nav-link text-foreground/80 hover:text-primary inline-block transition-all duration-150"
            >
              {{ _("Shipping & Payment") }}
            </a>
          </li>
          <li>
            <a
              href="{{ url_for('profile') }}"
              class="footer__nav-link text-foreground/80 hover:text-primary inline-block transition-all duration-150"
            >
              {{ _("My Account") }}
            </a>
          </li>
          <li>
            <a
              href="{{ url_for('wishlist') }}"
              class="footer__nav-link text-foreground/80 hover:text-primary inline-block transition-all duration-150"
            >
              {{ _("Wishlist") }}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <hr class="footer__divider border-border my-0" />

    <!-- Bottom Footer Row -->
    <div
      class="footer__bottom text-muted flex flex-col items-center justify-between gap-5 py-6 text-xs md:flex-row"
    >
      <!-- Translatable Copyright Sentence -->
      {% set store_label = store.settings.branding.copyrights | default(store.name, true) %}
      <p class="footer__copyright m-0 text-center md:text-start">
        {% trans name=store_label %}© {{ name }} — All Rights Reserved.{% endtrans %}
      </p>

      <!-- Dynamic Payment Methods from Store Settings -->
      {% if safeget(settings, "footer_show_payment_methods", true) %}
        {% set payment_methods = store.settings.checkout.payment_methods %}
        {% if payment_methods is defined and payment_methods is iterable and payment_methods|length > 0 %}
          <div class="footer__payment flex flex-wrap items-center gap-2">
            {% for method in payment_methods %}
              {% set method_name = method.name | default(method.title, true) | default(method.code, true) %}
              {% set method_logo = method.logo | default(method.icon, true) | default(method.image, true) %}
              {% if method_logo %}
                <img
                  src="{{ method_logo }}"
                  alt="{{ method_name }}"
                  class="border-border bg-surface h-6 w-auto max-w-[50px] rounded border object-contain px-1 py-0.5"
                />
              {% elif method_name %}
                <span
                  class="bg-surface border-border text-foreground rounded border px-2.5 py-1 text-[11px] font-medium"
                  >{{ method_name }}</span
                >
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
</footer>
