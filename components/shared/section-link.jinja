{% set link_lbl = link_label | default('', true) %}
{% set link_href = link_url | default('', true) %}
{% set extra_class = class | default('', true) %}
{% set reveal_delay = delay | default('0.32s', true) %}

{% if link_lbl and link_href %}
  <a
    href="{{ link_href }}"
    class="section-header__link {{ extra_class }}"
    data-reveal-item="text"
    style="--d: {{ reveal_delay }}"
  >
    <span>{{ link_lbl }}</span>
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="section-header__link-icon rtl:rotate-180"
      aria-hidden="true"
    >
      <path d="M5 12h14M12 5l7 7-7 7" />
    </svg>
  </a>
{% endif %}
