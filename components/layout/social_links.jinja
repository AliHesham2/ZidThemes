      <a
        href="{{ contact.twitter }}"
        target="_blank"
        rel="noopener noreferrer"
        class="footer__social-link text-foreground hover:text-primary border-border bg-surface inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border transition-all duration-150"
        aria-label="X / Twitter"
