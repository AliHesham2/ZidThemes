<div
  id="mobile-drawer"
  class="drawer drawer--mobile z-drawer invisible fixed inset-0"
  aria-hidden="true"
  data-drawer="mobile"
>
  <!-- Backdrop -->
  <div
    class="drawer__backdrop bg-scrim/50 fixed inset-0 opacity-0 transition-opacity duration-300"
    data-drawer-close
  ></div>

  <!-- Panel (start-0 logical anchor) -->
  <div
    class="mobile-drawer__inner bg-surface fixed start-0 top-0 bottom-0 z-10 flex w-full max-w-sm -translate-x-full transform flex-col overflow-hidden shadow-lg transition-transform duration-300 ease-out rtl:translate-x-full"
  >
    <!-- Drawer Header -->
    <div class="mobile-drawer__header border-border flex items-center justify-between border-b p-4">
      <span class="font-heading text-foreground text-lg font-bold">{{ store.name }}</span>
      <button
        type="button"
        class="mobile-drawer__close text-foreground hover:text-primary inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md p-2"
        data-drawer-close
        aria-label="{{ _('Close menu') }}"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 20 20">
          <path
            d="m5 5 10 10M15 5 5 15"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
          />
        </svg>
      </button>
    </div>

    <!-- Drawer Body -->
    <div class="mobile-drawer__body flex-1 space-y-6 overflow-y-auto p-4">
      <!-- Search Input Trigger -->
      <button
        type="button"
        class="bg-secondary/30 text-muted flex w-full items-center gap-3 rounded-md px-4 py-3 text-sm"
        data-drawer-trigger="search"
      >
        <svg
          class="text-foreground h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="var(--icon-stroke-width, 1.25)"
        >
          <circle cx="10.5" cy="10.5" r="6.5" />
          <path d="M15.5 15.5L21 21" stroke-linecap="round" />
        </svg>
        <span>{{ _("Search products...") }}</span>
      </button>

      <!-- Navigation Menu -->
      <nav class="mobile-drawer__nav space-y-1" aria-label="{{ _('Mobile Menu') }}">
        {% set menu_items = store.settings.menus.main_menu.items %}
        {% if menu_items and menu_items is iterable %}
          {% for menu in menu_items %}
            {% set has_children = menu.items is defined and menu.items is iterable and menu.items|length > 0 %}
            {% if has_children %}
              <details class="mobile-drawer__details group border-border/40 border-b py-1">
                <summary
                  class="mobile-drawer__summary text-foreground flex min-h-[44px] cursor-pointer list-none items-center justify-between py-2 text-base font-medium"
                >
                  <span>{{ menu.label }}</span>
                  <svg
                    class="h-3 w-3 transition-transform duration-200 group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 12 12"
                  >
                    <path
                      d="M2.5 4.5L6 8L9.5 4.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                    />
                  </svg>
                </summary>
                <div class="space-y-1 ps-4 pt-1 pb-2">
                  {% for submenu in menu.items %}
                    {% set has_sub_children = submenu.items is defined and submenu.items is iterable and submenu.items|length > 0 %}
                    <a
                      href="{{ submenu.url | localized_url if submenu.resource_type != 'url' else submenu.url }}"
                      class="mobile-drawer__link text-foreground hover:text-primary flex min-h-[44px] items-center py-2 text-sm"
                    >
                      {{ submenu.label }}
                    </a>
                    {% if has_sub_children %}
                      <div class="space-y-1 ps-3">
                        {% for leaf in submenu.items %}
                          <a
                            href="{{ leaf.url | localized_url if leaf.resource_type != 'url' else leaf.url }}"
                            class="mobile-drawer__link text-muted hover:text-primary flex min-h-[44px] items-center py-1.5 text-xs"
                          >
                            {{ leaf.label }}
                          </a>
                        {% endfor %}
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              </details>
            {% else %}
              <a
                href="{{ menu.url | localized_url if menu.resource_type != 'url' else menu.url }}"
                class="mobile-drawer__link text-foreground hover:text-primary border-border/40 flex min-h-[44px] items-center border-b py-3 text-base font-medium"
              >
                {{ menu.label }}
              </a>
            {% endif %}
          {% endfor %}
        {% endif %}
      </nav>

      <!-- Account & Wishlist Links -->
      <div class="border-border space-y-2 border-t pt-4">
        <a
          href="{{ url_for('profile') }}"
          class="text-foreground hover:text-primary flex min-h-[44px] items-center gap-3 py-2 text-sm"
          data-account-trigger
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="var(--icon-stroke-width, 1.25)"
          >
            <circle cx="12" cy="8" r="3.5" />
            <path d="M5 20c0-3.866 3.134-7 7-7s7 3.134 7 7" stroke-linecap="round" />
          </svg>
          <span>{{ _("My Account") }}</span>
        </a>
        <a
          href="{{ url_for('wishlist') }}"
          class="text-foreground hover:text-primary flex min-h-[44px] items-center gap-3 py-2 text-sm"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="var(--icon-stroke-width, 1.25)"
          >
            <path
              d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
              stroke-linecap="round"
            />
          </svg>
          <span>{{ _("Wishlist") }}</span>
        </a>
      </div>

      <!-- Region & Language Selector Trigger -->
      <div class="mobile-drawer__localization pt-2">
        <button
          type="button"
          onclick="window.zidCloseDrawersBeforePopup?.(() => window.zidOpenRegionSettingDialog?.())"
          class="bg-secondary/20 text-foreground flex min-h-[44px] w-full items-center justify-between rounded-md px-4 py-3 text-sm font-medium"
        >
          <span class="flex items-center gap-2">
            <svg
              class="text-primary h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="var(--icon-stroke-width, 1.25)"
            >
              <circle cx="12" cy="12" r="9" stroke="currentColor" />
              <path d="M3.6 9h16.8M3.6 15h16.8" stroke="currentColor" stroke-linecap="round" />
              <path d="M11.5 3a17 17 0 0 0 0 18M12.5 3a17 17 0 0 1 0 18" stroke="currentColor" />
            </svg>
            <span>{{ _("Country & Language") }}</span>
          </span>
          <span class="bg-surface border-border rounded border px-2 py-1 text-xs uppercase"
            >{{ session.lang }}</span
          >
        </button>
      </div>
    </div>
  </div>
</div>
