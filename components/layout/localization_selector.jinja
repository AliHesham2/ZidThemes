{#
  Currency + language selector.

  Option lists come from `store.countries` / `store.languages`, which Zid
  exposes directly in the template context — the same source GrowthTheme uses
  (`components/header/region-selector.jinja`). These are UNDOCUMENTED: they
  appear nowhere in the docs mirror. Do not replace them with the async
  `zid.store.region.*` calls — fetching at runtime what the server already
  knows is what made this control silently dead.

  JS is only needed to open/close the panel and to call setRegion on click.
#}
{% set languages = store.languages | default([], true) %}
{% set countries = store.countries | default([], true) %}
{% set multiple_languages = languages | length > 1 %}
{% set multiple_countries = countries | length > 1 %}

{# setRegion requires BOTH language and country_code on every call, so the
   current value of whichever one isn't changing has to travel with it. #}
<div
  class="hdr-loc-group text-foreground hidden items-center gap-3 text-xs font-medium lg:flex"
  data-localization-group
  data-current-lang="{{ session.lang | default('ar', true) }}"
  data-current-country="{{ session.country.code | default(session.country.iso_code_2, true) | default('SA', true) }}"
>
  {# Currency comes from `store.settings.general.currency`, which is DOCUMENTED
     (`currency.{id,name,code,symbol,symbol_left,symbol_right}`).
     `session.currency` renders the localised NAME — "ريال" instead of "SAR". #}
  {% set cur = store.settings.general.currency %}
  {% set cur_code = cur.code | default('SAR', true) %}
  {% set cur_symbol = cur.symbol | default('﷼', true) %}

  {# ── Currency ───────────────────────────────────────────────────────── #}
  <div class="hdr-loc-wrapper relative" data-loc-currency-wrapper>
    {% if multiple_countries %}
      <button
        type="button"
        class="hdr-loc-btn hover:bg-secondary/40 focus-visible:ring-ring flex cursor-pointer items-center gap-1 rounded px-2 py-1 transition-colors focus-visible:ring-1 focus-visible:outline-none"
        data-loc-trigger="currency"
        data-current-currency="{{ cur_code }}"
        aria-expanded="false"
        aria-haspopup="true"
      >
        <span class="font-bold">{{ cur_symbol }}</span>
        <span>{{ cur_code }}</span>
        <svg
          class="js-loc-chevron h-2.5 w-2.5 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 12 12"
          aria-hidden="true"
        >
          <path
            d="M2.5 4.5L6 8L9.5 4.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          />
        </svg>
      </button>
    {% else %}
      {# Single currency — plain text, not a control. #}
      <span class="hdr-loc-static flex items-center gap-1 px-2 py-1">
        <span class="font-bold">{{ cur_symbol }}</span>
        <span>{{ cur_code }}</span>
      </span>
    {% endif %}

    {% if multiple_countries %}
      <div
        class="hdr-loc-dropdown bg-surface border-border z-dropdown absolute start-0 top-full mt-1 hidden min-w-[160px] rounded-md border p-1.5 shadow-md"
        data-loc-dropdown="currency"
      >
        {% for country in countries %}
          {% set c_code = country.currency_code | default(country.code, true) %}
          <button
            type="button"
            class="hover:bg-secondary/40 {{ 'text-primary font-bold' if c_code == cur_code else 'text-foreground' }} flex w-full items-center justify-between rounded px-2 py-1.5 text-start text-xs transition-colors"
            data-country-code="{{ country.code | default(country.iso_code_2, true) }}"
            {% if c_code == cur_code %}aria-current="true"{% endif %}
          >
            <span>{{ country.name }}</span>
            <span class="text-muted">{{ c_code }}</span>
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {# ── Language ───────────────────────────────────────────────────────── #}
  <div class="hdr-loc-wrapper relative" data-loc-language-wrapper>
    {% set globe_svg %}
      <svg
        class="text-muted h-3.5 w-3.5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10" stroke-width="var(--icon-stroke-width, 1.25)" />
        <path
          d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
          stroke-width="var(--icon-stroke-width, 1.25)"
        />
      </svg>
    {% endset %}

    {% if multiple_languages %}
      <button
        type="button"
        class="hdr-loc-btn hover:bg-secondary/40 focus-visible:ring-ring flex cursor-pointer items-center gap-1 rounded px-2 py-1 transition-colors focus-visible:ring-1 focus-visible:outline-none"
        data-loc-trigger="language"
        data-current-lang="{{ session.lang | default('ar', true) }}"
        aria-expanded="false"
        aria-haspopup="true"
      >
        {{ globe_svg }}
        <span class="font-bold uppercase">{{ session.lang | default('ar', true) }}</span>
        <svg
          class="js-loc-chevron h-2.5 w-2.5 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 12 12"
          aria-hidden="true"
        >
          <path
            d="M2.5 4.5L6 8L9.5 4.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          />
        </svg>
      </button>
    {% else %}
      {# Single language — plain text, not a control. #}
      <span class="hdr-loc-static flex items-center gap-1 px-2 py-1">
        {{ globe_svg }}
        <span class="font-bold uppercase">{{ session.lang | default('ar', true) }}</span>
      </span>
    {% endif %}

    {% if multiple_languages %}
      <div
        class="hdr-loc-dropdown bg-surface border-border z-dropdown absolute start-0 top-full mt-1 hidden min-w-[140px] rounded-md border p-1.5 shadow-md"
        data-loc-dropdown="language"
      >
        {% for language in languages %}
          {% set l_code = language.code | default(language.iso_code, true) %}
          <button
            type="button"
            class="hover:bg-secondary/40 {{ 'text-primary font-bold' if l_code == session.lang else 'text-foreground' }} flex w-full items-center justify-between rounded px-2 py-1.5 text-start text-xs transition-colors"
            data-lang-code="{{ l_code }}"
            {% if l_code == session.lang %}aria-current="true"{% endif %}
          >
            <span>{{ language.name | default(l_code | upper, true) }}</span>
            {% if l_code == session.lang %}<span aria-hidden="true">✓</span>{% endif %}
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
