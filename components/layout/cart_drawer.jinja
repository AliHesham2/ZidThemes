<div
  id="cart-drawer"
  class="drawer drawer--cart z-drawer invisible fixed inset-0"
  aria-hidden="true"
  data-drawer="cart"
>
  <!-- Backdrop -->
  <div
    class="drawer__backdrop bg-scrim/50 fixed inset-0 opacity-0 transition-opacity duration-300"
    data-drawer-close
  ></div>

  <!-- Panel (end-0 logical anchor) -->
  <div
    class="cart-drawer__inner bg-surface fixed end-0 top-0 bottom-0 z-10 flex w-full max-w-md translate-x-full transform flex-col overflow-hidden shadow-lg transition-transform duration-300 ease-out rtl:-translate-x-full"
  >
    <!-- Header -->
    <div class="cart-drawer__header border-border flex items-center justify-between border-b p-4">
      <h2
        class="cart-drawer__title font-heading text-foreground m-0 flex items-center gap-2 text-lg font-bold"
      >
        <span>{{ _("Shopping Cart") }}</span>
        <span
          class="js-cart-count-badge bg-primary text-primary-foreground hidden rounded-full px-2 py-0.5 font-sans text-xs font-medium"
        ></span>
      </h2>
      <button
        type="button"
        class="cart-drawer__close text-foreground hover:text-primary inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md p-2"
        data-drawer-close
        aria-label="{{ _('Close cart') }}"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    </div>

    <!-- Body -->
    <div class="cart-drawer__body flex-1 overflow-y-auto p-4">
      <!-- Items Container -->
      <div class="cart-drawer__items space-y-4">
        <!-- Rendered via JS -->
      </div>

      <!-- Empty State -->
      <div
        class="cart-drawer__empty flex hidden flex-col items-center justify-center py-12 text-center"
      >
        <div class="cart-drawer__empty-icon bg-secondary/30 text-primary mb-4 rounded-full p-4">
          <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
            />
          </svg>
        </div>
        <p class="text-foreground mb-2 text-lg font-medium">{{ _("Your cart is empty") }}</p>
        <p class="text-muted mb-6 text-sm">{{ _("Explore our products and start shopping") }}</p>
        <a
          href="{{ url_for('list_products') }}"
          class="btn btn-filled btn-md min-h-[44px]"
          data-drawer-close
        >
          {{ _("Continue Shopping") }}
        </a>
      </div>
    </div>

    <!-- Footer -->
    <div class="cart-drawer__footer border-border bg-secondary/10 space-y-4 border-t p-4">
      <!-- Totals List (Rendered dynamically from cart.totals) -->
      <div class="cart-drawer__totals text-foreground space-y-2 text-sm">
        <div class="cart-drawer__totals-list space-y-1"></div>
        <p class="cart-drawer__tax-note text-muted m-0 pt-1 text-xs">
          {{ _("Taxes and shipping calculated at checkout.") }}
        </p>
      </div>

      <!-- Checkout Button -->
      <div class="space-y-2">
        <a
          href="{{ url_for('cart_page') }}"
          class="cart-drawer__checkout-button btn btn-filled btn-lg flex min-h-[44px] w-full items-center justify-center gap-2"
        >
          <span>{{ _("View Cart & Checkout") }}</span>
          <svg class="h-5 w-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
