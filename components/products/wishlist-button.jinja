{% if store.settings.products.wishlist_enabled == true %}
  <button
    type="button"
    class="wishlist-btn {{ class | default('', true) }}"
    data-wishlist-btn
    data-product-id="{{ product_id }}"
    data-label-add="{{ _('Add to wishlist') }}"
    data-label-remove="{{ _('Remove from wishlist') }}"
    data-label-loading="{{ _('Loading') }}"
    aria-label="{{ _('Add to wishlist') }}"
    aria-pressed="false"
  >
    <span class="wishlist-btn__icon wishlist-btn__icon--empty" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
        />
      </svg>
    </span>
    <span class="wishlist-btn__icon wishlist-btn__icon--filled" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor" stroke="none">
        <path
          d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
        />
      </svg>
    </span>
    <span class="wishlist-btn__icon wishlist-btn__icon--spinner" aria-hidden="true">
      <svg class="spinner-ring" viewBox="0 0 50 50">
        <circle
          class="spinner-ring__path"
          cx="25"
          cy="25"
          r="20"
          fill="none"
          stroke-width="5"
        ></circle>
      </svg>
    </span>
  </button>
{% endif %}
