{% set card_product = product %}
{% set ratio = image_ratio | default('4-5', true) %}

{% if not card_product %}
  <article
    class="product-card product-card--placeholder {{ class | default('', true) }}"
    data-reveal-item="card"
    aria-hidden="true"
    tabindex="-1"
    {% if index is defined %}style="--i: {{ index }}"{% endif %}
  >
    <div class="product-card__media-wrapper product-card__media-wrapper--{{ ratio }}">
      <div class="product-card__carousel-track">
        <div class="product-card__carousel-slide" data-index="0">
          <img
            src="{{ 'images/product-placeholder.svg' | asset_url }}"
            alt=""
            aria-hidden="true"
            width="220"
            height="280"
            loading="lazy"
            class="product-card__image product-card__image--placeholder"
          />
        </div>
      </div>
      <div class="product-card__notch" aria-hidden="true">
        <span class="product-card__quick-view-btn">
          <span class="product-card__notch-ico product-card__notch-ico--add">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 5v14M5 12h14" />
            </svg>
          </span>
        </span>
      </div>
    </div>
    <div class="product-card__info">
      <h3 class="product-card__title">{{ _("Product title") }}</h3>
      <p class="product-card__description">{{ _("A short product description appears here.") }}</p>
    </div>
  </article>
{% else %}
  {% set product_url = url_for('product_details', slug=card_product.slug) if card_product.slug else '#' %}

  {% set sp = card_product.selected_product if card_product.selected_product is defined else none %}
  {% set in_stock_flag = sp.in_stock if (sp and sp.in_stock is defined and sp.in_stock is not none) else (card_product.in_stock if (card_product.in_stock is defined and card_product.in_stock is not none) else true) %}
  {% set qty = card_product.quantity if (card_product.quantity is defined and card_product.quantity is not none) else none %}
  {% set is_infinite = card_product.is_infinite if (card_product.is_infinite is defined) else false %}
  {% set is_sold_out = (not in_stock_flag) or (is_infinite == false and qty is not none and qty <= 0) %}

  {% set badge_obj = card_product.badge if card_product.badge is defined else none %}
  {% set badge_text = "" %}
  {% if badge_obj %}
    {% if badge_obj is string %}
      {% set badge_text = badge_obj %}
    {% elif badge_obj.body is defined and badge_obj.body %}
      {% set badge_ar = badge_obj.body.ar if badge_obj.body.ar is defined else "" %}
      {% set badge_en = badge_obj.body.en if badge_obj.body.en is defined else "" %}
      {% set badge_text = (badge_ar or badge_en) if session.lang == 'ar' else (badge_en or badge_ar) %}
    {% endif %}
  {% endif %}

  {% set is_on_sale = (card_product.formatted_sale_price is defined and card_product.formatted_sale_price is not none) %}
  {% set discount_pct = card_product.discount_percentage if (card_product.discount_percentage is defined and card_product.discount_percentage) else 0 %}

  {% set regular_price = card_product.formatted_price | default('', true) %}
  {% set sale_price = card_product.formatted_sale_price if is_on_sale else '' %}
  {% set has_options = card_product.has_options if card_product.has_options is defined else false %}
  {% set has_fields = card_product.has_fields if card_product.has_fields is defined else false %}

  {% set color_opts = [] %}
  {% set other_opts = [] %}
  {% if card_product and card_product.options %}
    {% for opt in card_product.options %}
      {% set ns = namespace(is_color=false) %}
      {% set choices = opt.choices or [] %}
      {% set meta_map = opt.choices_metadata or {} %}
      {% for choice in choices %}
        {% set meta = meta_map[choice] if meta_map[choice] is defined else none %}
        {% if meta and meta.type == 'color' %}
          {% set ns.is_color = true %}
        {% endif %}
      {% endfor %}
      {% if ns.is_color %}
        {% set _ = color_opts.append(opt) %}
      {% else %}
        {% set _ = other_opts.append(opt) %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% set can_direct_add = (not is_sold_out) and (not has_fields) and (other_opts|length == 0) and (color_opts|length <= 1) %}
  {% set card_add_mode = 'none' if is_sold_out else ('color' if (can_direct_add and color_opts|length == 1) else ('simple' if can_direct_add else 'dialog')) %}

  {% set media_list = card_product.images if (card_product.images and card_product.images|length > 0) else (card_product.selected_product.media if (card_product.selected_product and card_product.selected_product.media) else []) %}
  {% set main_img = card_product.main_image if card_product.main_image is defined else none %}

  <article
    class="product-card {{ class | default('', true) }}"
    data-product-card
    data-reveal-item="card"
    data-product-url="{{ product_url }}"
    {% if index is defined %}style="--i: {{ index }}"{% endif %}
  >
    <div class="product-card__media-wrapper product-card__media-wrapper--{{ ratio }}">
      <div class="product-card__badge-slot">
        {% if is_sold_out %}
          <span class="pc-badge pc-badge--soldout"
            ><span class="pc-badge__text">{{ _("Sold out") }}</span></span
          >
        {% elif badge_text %}
          <span class="pc-badge pc-badge--merchant"
            ><span class="pc-badge__text">{{ badge_text }}</span></span
          >
        {% elif is_on_sale %}
          <span class="pc-badge pc-badge--sale">
            <span class="pc-badge__face pc-badge__face--label"
              ><span class="pc-badge__text">{{ _("Sale") }}</span></span
            >
            {% if discount_pct > 0 %}
              <span class="pc-badge__face pc-badge__face--percent" aria-hidden="true"
                >-{{ discount_pct }}%</span
              >
            {% endif %}
          </span>
        {% endif %}
      </div>

      <div class="product-card__carousel-track" data-carousel-track>
        {% if media_list|length > 0 %}
          {% for media_item in media_list %}
            {% set img_src = media_item.image.full_size if (media_item and media_item.image and media_item.image.full_size) else none %}
            <div class="product-card__carousel-slide" data-index="{{ loop.index0 }}">
              <a
                href="{{ product_url }}"
                class="product-card__media-link"
                aria-label="{{ card_product.name }}"
              >
                {% if img_src %}
                  <img
                    src="{{ image_url(img_src, w=400, q=85, f='auto') }}"
                    srcset="
                      {{ image_url(img_src, w=400, q=85, f='auto') }} 400w,
                      {{ image_url(img_src, w=800, q=85, f='auto') }} 800w
                    "
                    sizes="(max-width: 639px) 100vw, (max-width: 767px) 50vw, (max-width: 1023px) 33vw, 320px"
                    alt="{{ card_product.name }}"
                    width="400"
                    height="500"
                    loading="lazy"
                    class="product-card__image"
                  />
                {% else %}
                  <img
                    src="{{ 'images/product-placeholder.svg' | asset_url }}"
                    alt=""
                    aria-hidden="true"
                    width="220"
                    height="280"
                    loading="lazy"
                    class="product-card__image product-card__image--placeholder"
                  />
                {% endif %}
              </a>
            </div>
          {% endfor %}
        {% elif main_img %}
          {% set img_src = main_img.image.full_size if (main_img.image and main_img.image.full_size) else (main_img.image.medium if main_img.image else none) %}
          <div class="product-card__carousel-slide" data-index="0">
            <a
              href="{{ product_url }}"
              class="product-card__media-link"
              aria-label="{{ card_product.name }}"
            >
              {% if img_src %}
                <img
                  src="{{ image_url(img_src, w=400, q=85, f='auto') }}"
                  srcset="
                    {{ image_url(img_src, w=400, q=85, f='auto') }} 400w,
                    {{ image_url(img_src, w=800, q=85, f='auto') }} 800w
                  "
                  sizes="(max-width: 639px) 100vw, (max-width: 767px) 50vw, (max-width: 1023px) 33vw, 320px"
                  alt="{{ card_product.name }}"
                  width="400"
                  height="500"
                  loading="lazy"
                  class="product-card__image"
                />
              {% else %}
                <img
                  src="{{ 'images/product-placeholder.svg' | asset_url }}"
                  alt=""
                  aria-hidden="true"
                  width="220"
                  height="280"
                  loading="lazy"
                  class="product-card__image product-card__image--placeholder"
                />
              {% endif %}
            </a>
          </div>
        {% else %}
          <div class="product-card__carousel-slide" data-index="0">
            <a
              href="{{ product_url }}"
              class="product-card__media-link"
              aria-label="{{ card_product.name }}"
            >
              <img
                src="{{ 'images/product-placeholder.svg' | asset_url }}"
                alt=""
                aria-hidden="true"
                width="220"
                height="280"
                loading="lazy"
                class="product-card__image product-card__image--placeholder"
              />
            </a>
          </div>
        {% endif %}
      </div>

      {% if media_list|length > 1 %}
        <button
          type="button"
          class="product-card__carousel-arrow product-card__carousel-arrow--prev"
          data-carousel-prev
          aria-label="{{ _('Previous') }}"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="rtl:rotate-180"
            aria-hidden="true"
          >
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </button>
        <button
          type="button"
          class="product-card__carousel-arrow product-card__carousel-arrow--next"
          data-carousel-next
          aria-label="{{ _('Next') }}"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="rtl:rotate-180"
            aria-hidden="true"
          >
            <path d="M9 18l6-6-6-6" />
          </svg>
        </button>

        <div class="product-card__carousel-dots">
          {% for media_item in media_list %}
            <button
              type="button"
              class="product-card__carousel-dot"
              data-carousel-dot="{{ loop.index0 }}"
              aria-label="{{ _('Image') }} {{ loop.index }}"
              {% if loop.first %}aria-current="true"{% endif %}
            >
              <span class="product-card__dot-inner"></span>
            </button>
          {% endfor %}
        </div>
      {% endif %}

      <div class="product-card__notch">
        {% if is_sold_out %}
          <button
            type="button"
            class="product-card__quick-view-btn product-card__quick-view-btn--sold-out"
            disabled
            aria-label="{{ _('Sold out') }}"
          >
            <span
              class="product-card__notch-ico product-card__notch-ico--soldout"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="9" />
                <line x1="5.6" y1="5.6" x2="18.4" y2="18.4" />
              </svg>
            </span>
          </button>
        {% elif card_add_mode == 'dialog' %}
          <a
            href="{{ product_url }}"
            class="product-card__quick-view-btn"
            data-card-add="dialog"
            data-product-id="{{ card_product.id }}"
            data-label-select-options="{{ _('Select options') }}"
            data-label-close="{{ _('Close dialog') }}"
            data-label-error="{{ _('Failed to add item to cart.') }}"
            aria-label="{{ _('Select options') }}"
          >
            <span class="product-card__notch-ico product-card__notch-ico--add" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </span>
          </a>
        {% else %}
          <button
            type="button"
            class="product-card__quick-view-btn"
            data-card-add="{{ card_add_mode }}"
            data-product-id="{{ card_product.id }}"
            data-label-add-to-cart="{{ _('Add to cart') }}"
            data-label-select-options="{{ _('Select options') }}"
            data-label-close="{{ _('Close dialog') }}"
            data-label-error="{{ _('Failed to add item to cart.') }}"
            aria-label="{{ _('Add to cart') }}"
          >
            <span class="product-card__notch-ico product-card__notch-ico--add" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </span>
            <span
              class="product-card__notch-ico product-card__notch-ico--spinner"
              aria-hidden="true"
            >
              <svg class="spinner-ring" viewBox="0 0 50 50">
                <circle
                  class="spinner-ring__path"
                  cx="25"
                  cy="25"
                  r="20"
                  fill="none"
                  stroke-width="5"
                ></circle>
              </svg>
            </span>
            <span class="product-card__notch-ico product-card__notch-ico--added" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 6L9 17l-5-5" />
              </svg>
            </span>
          </button>
        {% endif %}
      </div>
    </div>

    <div class="product-card__info">
      {% if card_product.name %}
        <h3 class="product-card__title">
          <a href="{{ product_url }}" class="product-card__title-link">{{ card_product.name }}</a>
        </h3>
      {% endif %}

      {% if card_product.options %}
        {% for option in card_product.options %}
          {% set choices = option.choices or [] %}
          {% set meta_map = option.choices_metadata or {} %}
          {% set swatch_choices = [] %}
          {% for choice in choices %}
            {% set meta = meta_map[choice] if meta_map[choice] is defined else none %}
            {% if meta and meta.type in ['color', 'icon'] and meta.type_value %}
              {% set _ = swatch_choices.append((choice, meta.type, meta.type_value, meta.id if meta.id is defined else '')) %}
            {% endif %}
          {% endfor %}
          {% if swatch_choices | length > 0 %}
            <div
              class="product-card__color-swatches"
              data-option-id="{{ option.id }}"
              aria-hidden="true"
            >
              {% for choice, swatch_type, swatch_value, choice_id in swatch_choices %}
                <span
                  class="product-card__swatch-dot{{ ' is-active' if loop.first else '' }}"
                  title="{{ choice }}"
                  data-choice-value="{{ choice }}"
                  data-choice-id="{{ choice_id }}"
                  style="{% if swatch_type == 'icon' %}
                    background-image: url('{{ swatch_value }}'); background-size: cover;
                  {% else %}
                    --swatch-color: {{ swatch_value }};
                  {% endif %}"
                ></span>
              {% endfor %}
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}

      {% set raw_desc = card_product.short_description | striptags if card_product.short_description else (card_product.description | striptags if card_product.description else '') %}
      {% set card_desc = raw_desc | truncate(80) if raw_desc else '' %}
      {% if card_desc %}
        <p class="product-card__description">{{ card_desc }}</p>
      {% endif %}

      <div class="product-card__price-row">
        <div class="product-card__price">
          {% if is_on_sale %}
            <ins class="product-card__sale-price">
              {%- if has_options %}{{ _("From") }}{% endif -%}
              {{ sale_price }}
            </ins>
            <del class="product-card__regular-price">{{ regular_price }}</del>
          {% else %}
            <span class="product-card__regular-price">
              {%- if has_options %}{{ _("From") }}{% endif -%}
              {{ regular_price }}
            </span>
          {% endif %}
        </div>
        <div class="product-card__actions">
          {% with product_id=card_product.id, class="product-card__wishlist-btn" %}
            {% include 'components/products/wishlist-button.jinja' %}
          {% endwith %}
          <a
            href="{{ product_url }}"
            class="product-card__quickview-icon"
            aria-label="{{ _('View Product') }}"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </a>
        </div>
      </div>
      <div class="product-card__error" role="status" aria-live="polite"></div>
    </div>
  </article>
{% endif %}
