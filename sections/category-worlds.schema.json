            {
              "value": "makeup",
              "label": {
                "ar": "مكياج",
                "en": "Makeup"
              }
            },
            {
              "value": "perfume",
              "label": {
                "ar": "عطور",
                "en": "Perfume"
              }
            },
            {
              "value": "organic",
              "label": {
                "ar": "عضوي",
                "en": "Organic"
              }
