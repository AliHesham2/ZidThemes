{% set is_show_desktop = safeget(settings, "show_on_desktop", true) %}
{% set is_show_mobile  = safeget(settings, "show_on_mobile",  true) %}

{% set eye = safeget(settings, "eyebrow", "") %}
{% set head = safeget(settings, "heading", "") %}
{% set raw_rows = safeget(settings, "rows", []) %}

{% set valid_rows = [] %}
{% for item in raw_rows %}
  {% if safeget(item, "is_visible", true) and (item.heading or item.text or item.image or item.product_image) %}
    {% set _ = valid_rows.append(item) %}
  {% endif %}
{% endfor %}

{% set row_count = valid_rows | length %}

{% if eye or head or row_count > 0 %}
  <section
    section-id="{{ sectionId }}"
    class="editorial {{ 'hidden lg:flex' if is_show_desktop and not is_show_mobile }} {{ 'flex lg:hidden' if is_show_mobile and not is_show_desktop }} {{ 'hidden' if not is_show_desktop and not is_show_mobile }} flex flex-col"
    data-reveal
    data-editorial
    data-row-count="{{ row_count }}"
  >
    <div class="theme-container flex flex-col gap-[var(--section-py)]">
      {% with eyebrow=eye, heading=head, align="center" %}
        {% include 'components/shared/section-header.jinja' %}
      {% endwith %}

      {% if row_count > 0 %}
        <div class="editorial__mobile-stack flex flex-col gap-12 lg:hidden">
          {% for r in valid_rows %}
            {% set acc = safeget(r, "accent", "rose") %}
            {% set lay = safeget(r, "layout", "image_first") %}
            <div
              class="editorial__row editorial__row--{{ acc }} flex flex-col gap-6 rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 shadow-sm"
              data-reveal-item="card"
              style="--i: {{ loop.index0 }}"
            >
              <div
                class="editorial__media-box relative aspect-[4/3] overflow-hidden rounded-[var(--radius-lg)] bg-[var(--ed-c1)]"
              >
                <div
                  class="editorial__circle absolute top-1/2 left-1/2 h-48 w-48 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--ed-c2)] opacity-40 blur-xl"
                ></div>
                {% if r.image or r.image_mobile %}
                  {% with image=r.image, image_mobile=r.image_mobile, alt=r.image_alt, class="editorial__kenburns w-full h-full object-cover relative z-10", sizes="(min-width: 1024px) 50vw, 90vw" %}
                    {% include 'components/shared/responsive-image.jinja' %}
                  {% endwith %}
                {% endif %}
                {% if r.product_image or r.product_image_mobile %}
                  <div
                    class="editorial__product-overlay absolute inset-0 z-20 flex items-center justify-center p-4"
                  >
                    {% with image=r.product_image, image_mobile=r.product_image_mobile, alt=r.heading, class="max-h-full max-w-full object-contain drop-shadow-xl", sizes="(min-width: 1024px) 30vw, 60vw" %}
                      {% include 'components/shared/responsive-image.jinja' %}
                    {% endwith %}
                  </div>
                {% endif %}
              </div>

              <div class="editorial__text-box flex flex-col gap-3">
                {% if r.eyebrow %}
                  <span
                    class="text-xs font-semibold tracking-[var(--tracking-eyebrow)] text-[var(--color-primary)] uppercase"
                  >
                    {{ r.eyebrow }}
                  </span>
                {% endif %}
                {% if r.heading %}
                  <h3 class="font-heading text-xl font-bold text-[var(--color-foreground)]">
                    {{ r.heading }}
                  </h3>
                {% endif %}
                {% if r.text %}
                  <div class="text-sm leading-relaxed text-[var(--color-muted)]">{{ r.text }}</div>
                {% endif %}
                {% if r.cta_label and r.cta_url %}
                  <div class="pt-2">
                    <a
                      href="{{ r.cta_url }}"
                      class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--color-primary)] hover:underline"
                    >
                      <span>{{ r.cta_label }}</span>
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="h-4 w-4 rtl:rotate-180"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14M12 5l7 7-7 7" />
                      </svg>
                    </a>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        <div
          class="editorial__desktop-journey relative hidden lg:block"
          style="height: calc({{ row_count }} * 100vh);"
          data-editorial-journey
        >
          <div
            class="editorial__sticky-stage sticky top-24 flex h-[calc(100vh-8rem)] w-full items-center justify-between gap-12"
            data-editorial-sticky
          >
            {% for r in valid_rows %}
              {% set acc = safeget(r, "accent", "rose") %}
              <div
                class="editorial__desktop-row editorial__row--{{ acc }} {% if loop.first %}
                  is-active opacity-100 z-10
                {% else %}
                  opacity-0 pointer-events-none z-0
                {% endif %} absolute inset-0 flex items-center justify-between gap-12 transition-all duration-500 ease-out"
                data-editorial-row="{{ loop.index0 }}"
              >
                <div
                  class="editorial__desktop-media relative aspect-[4/3] w-1/2 overflow-hidden rounded-[var(--radius-xl)] bg-[var(--ed-c1)] shadow-xl"
                >
                  <div
                    class="editorial__circle absolute top-1/2 left-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--ed-c2)] opacity-40 blur-2xl"
                  ></div>
                  {% if r.image or r.image_mobile %}
                    {% with image=r.image, image_mobile=r.image_mobile, alt=r.image_alt, class="editorial__kenburns w-full h-full object-cover relative z-10", sizes="50vw" %}
                      {% include 'components/shared/responsive-image.jinja' %}
                    {% endwith %}
                  {% endif %}
                  {% if r.product_image or r.product_image_mobile %}
                    <div
                      class="editorial__product-overlay absolute inset-0 z-20 flex items-center justify-center p-8"
                    >
                      {% with image=r.product_image, image_mobile=r.product_image_mobile, alt=r.heading, class="max-h-full max-w-full object-contain drop-shadow-2xl", sizes="30vw" %}
                        {% include 'components/shared/responsive-image.jinja' %}
                      {% endwith %}
                    </div>
                  {% endif %}
                </div>

                <div class="editorial__desktop-text flex w-1/2 flex-col gap-4 p-8">
                  {% if r.eyebrow %}
                    <span
                      class="text-xs font-semibold tracking-[var(--tracking-eyebrow)] text-[var(--color-primary)] uppercase"
                    >
                      {{ r.eyebrow }}
                    </span>
                  {% endif %}
                  {% if r.heading %}
                    <h3
                      class="font-heading text-3xl leading-snug font-bold text-[var(--color-foreground)]"
                    >
                      {{ r.heading }}
                    </h3>
                  {% endif %}
                  {% if r.text %}
                    <div class="text-base leading-relaxed text-[var(--color-muted)]">
                      {{ r.text }}
                    </div>
                  {% endif %}
                  {% if r.cta_label and r.cta_url %}
                    <div class="pt-4">
                      <a
                        href="{{ r.cta_url }}"
                        class="inline-flex items-center gap-2 rounded-full bg-[var(--color-primary)] px-6 py-3 text-sm font-semibold text-[var(--color-background)] transition-opacity hover:opacity-90"
                      >
                        <span>{{ r.cta_label }}</span>
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          class="h-4 w-4 rtl:rotate-180"
                          aria-hidden="true"
                        >
                          <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                      </a>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}
