{% set is_show_desktop = safeget(settings, "show_on_desktop", true) %}
{% set is_show_mobile  = safeget(settings, "show_on_mobile",  true) %}

{% set eye = safeget(settings, "eyebrow", "") %}
{% set head = safeget(settings, "heading", "") %}
{% set raw_rows = safeget(settings, "rows", []) %}

{% set valid_rows = [] %}
{% for item in raw_rows %}
  {% if safeget(item, "is_visible", true) and (item.heading or item.text or item.image or item.product_image) %}
    {% set _ = valid_rows.append(item) %}
  {% endif %}
{% endfor %}

{% set row_count = valid_rows | length %}

{% if eye or head or row_count > 0 %}
  <section
    section-id="{{ sectionId }}"
    class="editorial {{ 'hidden lg:flex' if is_show_desktop and not is_show_mobile }} {{ 'flex lg:hidden' if is_show_mobile and not is_show_desktop }} {{ 'hidden' if not is_show_desktop and not is_show_mobile }} flex flex-col"
    data-reveal
    data-editorial
    data-row-count="{{ row_count }}"
  >
    <div class="theme-container flex flex-col gap-[var(--section-py)]">
      {% with eyebrow=eye, heading=head, align="center", eyebrow_style="pill", ornament="star" %}
        {% include 'components/shared/section-header.jinja' %}
      {% endwith %}

      {% if row_count > 0 %}
        <div class="editorial__mobile-stack flex flex-col gap-12 lg:hidden">
          {% for r in valid_rows %}
            {% set acc = safeget(r, "accent", "rose") %}
            {% set lay = safeget(r, "layout", "image_first") %}
            {% set has_product = r.product_image or r.product_image_mobile %}
            {% set has_bg = r.image or r.image_mobile %}
            <div
              class="editorial__row editorial__row--{{ acc }} flex flex-col gap-6 rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6"
              data-reveal-item="card"
              style="--i: {{ loop.index0 }}"
              data-layout="{{ lay }}"
            >
              <div
                class="editorial__media-box relative aspect-[4/3] overflow-hidden rounded-[var(--radius-lg)] bg-[var(--ed-c1)]"
              >
                <div
                  class="editorial__circle absolute top-1/2 left-1/2 h-48 w-48 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--ed-c2)] opacity-40 blur-xl"
                ></div>
                <div class="ed-card-frame">
                  {% if has_bg %}
                    {% with image=r.image, image_mobile=r.image_mobile, alt=r.image_alt, class="ed-card-img w-full h-full object-cover", sizes="(min-width: 1024px) 50vw, 90vw" %}
                      {% include 'components/shared/responsive-image.jinja' %}
                    {% endwith %}
                  {% endif %}
                </div>
                {% if has_product or not has_bg %}
                  <div
                    class="editorial__product-overlay absolute inset-0 z-20 flex items-center justify-center p-4"
                  >
                    {% if has_product %}
                      {% with image=r.product_image, image_mobile=r.product_image_mobile, alt=r.heading, class="max-h-full max-w-full object-contain drop-shadow-xl", sizes="(min-width: 1024px) 30vw, 60vw", width=800, height=800 %}
                        {% include 'components/shared/responsive-image.jinja' %}
                      {% endwith %}
                    {% else %}
                      <span
                        class="ph-mark editorial__ph-mark"
                        aria-hidden="true"
                        style="-webkit-mask-image: url('{{ 'images/place-holder.webp' | asset_url }}'); mask-image: url('{{ 'images/place-holder.webp' | asset_url }}');"
                      ></span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>

              <div class="editorial__text-box flex flex-col gap-3">
                {% if r.eyebrow %}
                  <p class="editorial__row-eyebrow">
                    <span class="editorial__eyebrow-pip" aria-hidden="true"></span>
                    <span>{{ r.eyebrow }}</span>
                  </p>
                {% endif %}
                {% if r.heading %}
                  <h3 class="editorial__row-heading">{{ r.heading }}</h3>
                {% endif %}
                {% if r.text %}
                  <div
                    class="editorial__text-content text-sm leading-relaxed text-[var(--color-muted)]"
                  >
                    {{ r.text }}
                  </div>
                {% endif %}
                {% if r.cta_label and r.cta_url %}
                  <div class="pt-2">
                    {% with label=r.cta_label, url=r.cta_url, variant="outline", size="md", icon="arrow" %}
                      {% include 'components/ui/pill-button.jinja' %}
                    {% endwith %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        <div
          class="editorial__journey relative hidden lg:block"
          style="--ed-block-count: {{ row_count }}; height: calc({{ row_count }} * 100vh);"
          data-editorial-journey
        >
          <div
            class="editorial__panel sticky top-0 flex h-screen w-full items-center overflow-hidden"
            data-editorial-panel
          >
            <div
              class="editorial__inner theme-container flex h-[82vh] w-full items-center justify-between gap-12"
              data-editorial-inner
            >
              <div
                class="editorial__text-container relative flex flex-1 flex-col justify-center"
                data-editorial-texts
              >
                {% for r in valid_rows %}
                  {% set lay = safeget(r, "layout", "image_first") %}
                  <div
                    class="editorial__text-panel absolute inset-x-0 flex flex-col gap-4"
                    data-editorial-text="{{ loop.index0 }}"
                    data-layout="{{ lay }}"
                    {% if not loop.first %}inert{% endif %}
                  >
                    {% if r.eyebrow %}
                      <p class="editorial__row-eyebrow">
                        <span class="editorial__eyebrow-pip" aria-hidden="true"></span>
                        <span>{{ r.eyebrow }}</span>
                      </p>
                    {% endif %}
                    {% if r.heading %}
                      <h3 class="editorial__row-heading">{{ r.heading }}</h3>
                    {% endif %}
                    {% if r.text %}
                      <div class="editorial__text-content text-base leading-relaxed">
                        {{ r.text }}
                      </div>
                    {% endif %}
                    {% if r.cta_label and r.cta_url %}
                      <div class="pt-4">
                        {% with label=r.cta_label, url=r.cta_url, variant="outline", size="md", icon="arrow" %}
                          {% include 'components/ui/pill-button.jinja' %}
                        {% endwith %}
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}

                <div
                  class="editorial__footer absolute inset-x-0 bottom-0 flex items-center justify-between border-t border-[var(--vit-rim)] pt-4 text-xs"
                >
                  <div
                    class="editorial__chapter font-semibold"
                    data-editorial-chapter
                    style="--vit-n: {{ valid_rows | length }};"
                  >
                    <span class="px-1 text-[var(--gold)] opacity-60">⁄</span>
                  </div>
                </div>
              </div>

              <div
                class="editorial__stage relative aspect-[1/1.28] h-[78vh] w-auto flex-shrink-0"
                data-editorial-stage
              >
                <div class="editorial__case">
                  <div class="editorial__pool" data-editorial-pool></div>
                  <div class="editorial__contact" data-editorial-contact></div>

                  <div
                    class="editorial__objects-stack absolute inset-0 flex items-center justify-center p-8"
                  >
                    {% for r in valid_rows %}
                      {% set acc = safeget(r, "accent", "rose") %}
                      {% set lay = safeget(r, "layout", "image_first") %}
                      {% set has_product = r.product_image or r.product_image_mobile %}
                      {% set has_bg = r.image or r.image_mobile %}
                      <div
                        class="editorial__card absolute inset-0 flex items-center justify-center"
                        data-editorial-card="{{ loop.index0 }}"
                        data-layout="{{ lay }}"
                      >
                        {% if has_product or not has_bg %}
                          <div
                            class="editorial__object-item flex flex-col items-center justify-center"
                          >
                            {% if has_product %}
                              {% with image=r.product_image, image_mobile=r.product_image_mobile, alt=r.heading, class="max-h-full max-w-full object-contain drop-shadow-2xl", sizes="30vw", width=800, height=800 %}
                                {% include 'components/shared/responsive-image.jinja' %}
                              {% endwith %}
                              <div
                                class="editorial__reflection pointer-events-none"
                                aria-hidden="true"
                              >
                                {% with image=r.product_image, image_mobile=r.product_image_mobile, alt="", class="max-h-full max-w-full object-contain", sizes="30vw", width=800, height=800 %}
                                  {% include 'components/shared/responsive-image.jinja' %}
                                {% endwith %}
                              </div>
                            {% else %}
                              <span
                                class="ph-mark editorial__ph-mark"
                                aria-hidden="true"
                                style="-webkit-mask-image: url('{{ 'images/place-holder.webp' | asset_url }}'); mask-image: url('{{ 'images/place-holder.webp' | asset_url }}');"
                              ></span>
                              <div
                                class="editorial__reflection pointer-events-none"
                                aria-hidden="true"
                              >
                                <span
                                  class="ph-mark editorial__ph-mark"
                                  aria-hidden="true"
                                  style="-webkit-mask-image: url('{{ 'images/place-holder.webp' | asset_url }}'); mask-image: url('{{ 'images/place-holder.webp' | asset_url }}');"
                                ></span>
                              </div>
                            {% endif %}
                          </div>
                        {% elif has_bg %}
                          <div class="ed-card-frame">
                            {% with image=r.image, image_mobile=r.image_mobile, alt=r.image_alt, class="ed-card-img w-full h-full object-cover", sizes="50vw", is_priority=loop.first %}
                              {% include 'components/shared/responsive-image.jinja' %}
                            {% endwith %}
                          </div>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>

                  <div class="editorial__sweep" data-editorial-sweep></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}
