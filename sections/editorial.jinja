{% set is_show_desktop = safeget(settings, "show_on_desktop", true) %}
{% set is_show_mobile  = safeget(settings, "show_on_mobile",  true) %}

{% set eye = safeget(settings, "eyebrow", "") %}
{% set head = safeget(settings, "heading", "") %}
{% set raw_rows = safeget(settings, "rows", []) %}

{% set valid_rows = [] %}
{% for item in raw_rows %}
  {% if safeget(item, "is_visible", true) and (item.heading or item.text or item.image or item.product_image) %}
    {% set _ = valid_rows.append(item) %}
  {% endif %}
{% endfor %}

{% set row_count = valid_rows | length %}

{% if eye or head or row_count > 0 %}
  <section
    section-id="{{ sectionId }}"
    class="editorial {{ 'hidden lg:flex' if is_show_desktop and not is_show_mobile }} {{ 'flex lg:hidden' if is_show_mobile and not is_show_desktop }} {{ 'hidden' if not is_show_desktop and not is_show_mobile }} flex flex-col"
    data-reveal
    data-editorial
    data-row-count="{{ row_count }}"
  >
    <div class="theme-container flex flex-col gap-[var(--section-py)]">
      {% with eyebrow=eye, heading=head, align="center" %}
        {% include 'components/shared/section-header.jinja' %}
      {% endwith %}

      {% if row_count > 0 %}
        {# Mobile Stack: shown below lg breakpoint or when prefers-reduced-motion is active #}
        <div class="editorial__mobile-stack flex flex-col gap-12 lg:hidden">
          {% for r in valid_rows %}
            {% set acc = safeget(r, "accent", "rose") %}
            {% set lay = safeget(r, "layout", "image_first") %}
            <div
              class="editorial__row editorial__row--{{ acc }} flex flex-col gap-6 rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 shadow-sm"
              data-reveal-item="card"
              style="--i: {{ loop.index0 }}"
              data-layout="{{ lay }}"
            >
              <div
                class="editorial__media-box relative aspect-[4/3] overflow-hidden rounded-[var(--radius-lg)] bg-[var(--ed-c1)]"
              >
                <div
                  class="editorial__circle absolute top-1/2 left-1/2 h-48 w-48 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--ed-c2)] opacity-40 blur-xl"
                ></div>
                <div class="ed-card-frame">
                  {% if r.image or r.image_mobile %}
                    {% with image=r.image, image_mobile=r.image_mobile, alt=r.image_alt, class="ed-card-img w-full h-full object-cover", sizes="(min-width: 1024px) 50vw, 90vw" %}
                      {% include 'components/shared/responsive-image.jinja' %}
                    {% endwith %}
                  {% endif %}
                </div>
                {% if r.product_image or r.product_image_mobile %}
                  <div
                    class="editorial__product-overlay absolute inset-0 z-20 flex items-center justify-center p-4"
                  >
                    {% with image=r.product_image, image_mobile=r.product_image_mobile, alt=r.heading, class="max-h-full max-w-full object-contain drop-shadow-xl", sizes="(min-width: 1024px) 30vw, 60vw" %}
                      {% include 'components/shared/responsive-image.jinja' %}
                    {% endwith %}
                  </div>
                {% endif %}
              </div>

              <div class="editorial__text-box flex flex-col gap-3">
                {% if r.eyebrow %}
                  <p class="editorial__row-eyebrow">
                    <span class="editorial__eyebrow-pip" aria-hidden="true"></span>
                    <span>{{ r.eyebrow }}</span>
                  </p>
                {% endif %}
                {% if r.heading %}
                  <h3 class="editorial__row-heading">
                    {{ r.heading }}
                  </h3>
                {% endif %}
                {% if r.text %}
                  <div class="editorial__text-content text-sm leading-relaxed text-[var(--color-muted)]">{{ r.text }}</div>
                {% endif %}
                {% if r.cta_label and r.cta_url %}
                  <div class="pt-2">
                    {% with label=r.cta_label, url=r.cta_url, variant="outline", size="md", icon="arrow" %}
                      {% include 'components/ui/pill-button.jinja' %}
                    {% endwith %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        {# Desktop Journey: pinned sticky panel & shared stage gliding left<->right #}
        <div
          class="editorial__journey relative hidden lg:block"
          style="--ed-block-count: {{ row_count }}; height: calc({{ row_count }} * 100vh);"
          data-editorial-journey
        >
          <div
            class="editorial__panel sticky top-0 flex h-screen w-full items-center overflow-hidden"
            data-editorial-panel
          >
            <div
              class="editorial__inner theme-container relative h-[82vh] w-full"
              data-editorial-inner
            >
              {# ONE Shared Stage #}
              <div
                class="editorial__stage absolute top-1/2 h-[78vh] w-auto aspect-[1/1.28] -translate-y-1/2"
                data-editorial-stage
              >
                {% for r in valid_rows %}
                  {% set acc = safeget(r, "accent", "rose") %}
                  {% set lay = safeget(r, "layout", "image_first") %}
                  <div
                    class="editorial__card editorial__row--{{ acc }} {{ 'is-active' if loop.first }}"
                    data-editorial-card="{{ loop.index0 }}"
                    data-layout="{{ lay }}"
                  >
                    <div
                      class="editorial__circle absolute top-1/2 left-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--ed-c2)] opacity-40 blur-2xl"
                    ></div>
                    <div class="ed-card-frame">
                      {% if r.image or r.image_mobile %}
                        {% with image=r.image, image_mobile=r.image_mobile, alt=r.image_alt, class="ed-card-img w-full h-full object-cover", sizes="50vw" %}
                          {% include 'components/shared/responsive-image.jinja' %}
                        {% endwith %}
                      {% endif %}
                    </div>
                    {% if r.product_image or r.product_image_mobile %}
                      <div
                        class="editorial__product-overlay absolute inset-0 z-[3] flex items-center justify-center p-8"
                      >
                        {% with image=r.product_image, image_mobile=r.product_image_mobile, alt=r.heading, class="max-h-full max-w-full object-contain drop-shadow-2xl", sizes="30vw" %}
                          {% include 'components/shared/responsive-image.jinja' %}
                        {% endwith %}
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>

              {# Fixed Column Text Panels #}
              <div class="editorial__text-container absolute inset-0 pointer-events-none" data-editorial-texts>
                {% for r in valid_rows %}
                  {% set lay = safeget(r, "layout", "image_first") %}
                  <div
                    class="editorial__text-panel absolute top-1/2 -translate-y-1/2 flex flex-col gap-4 p-4 pointer-events-auto"
                    data-editorial-text="{{ loop.index0 }}"
                    data-layout="{{ lay }}"
                    {% if not loop.first %}inert{% endif %}
                  >
                    {% if r.eyebrow %}
                      <p class="editorial__row-eyebrow">
                        <span class="editorial__eyebrow-pip" aria-hidden="true"></span>
                        <span>{{ r.eyebrow }}</span>
                      </p>
                    {% endif %}
                    {% if r.heading %}
                      <h3 class="editorial__row-heading">
                        {{ r.heading }}
                      </h3>
                    {% endif %}
                    {% if r.text %}
                      <div class="editorial__text-content text-base leading-relaxed text-[var(--color-muted)]">
                        {{ r.text }}
                      </div>
                    {% endif %}
                    {% if r.cta_label and r.cta_url %}
                      <div class="pt-4">
                        {% with label=r.cta_label, url=r.cta_url, variant="outline", size="md", icon="arrow" %}
                          {% include 'components/ui/pill-button.jinja' %}
                        {% endwith %}
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}
