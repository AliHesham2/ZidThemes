{% set is_show_desktop = safeget(settings, "show_on_desktop", true) %}
{% set is_show_mobile  = safeget(settings, "show_on_mobile",  true) %}

{% set eye = safeget(settings, "eyebrow", "") %}
{% set head = safeget(settings, "heading", "") %}
{% set auto_play = safeget(settings, "autoplay", true) %}
{% set speed = safeget(settings, "autoplay_speed", 6) | int %}
{% set raw_items = safeget(settings, "testimonials", []) %}

{% set valid_testimonials = [] %}
{% for item in raw_items %}
  {% if safeget(item, "is_visible", true) and (item.quote or item.author) %}
    {% set _ = valid_testimonials.append(item) %}
  {% endif %}
{% endfor %}

{% set total_count = valid_testimonials | length %}

{% if eye or head or total_count > 0 %}
  <section
    section-id="{{ sectionId }}"
    class="testimonials {{ 'hidden lg:flex' if is_show_desktop and not is_show_mobile }} {{ 'flex lg:hidden' if is_show_mobile and not is_show_desktop }} {{ 'hidden' if not is_show_desktop and not is_show_mobile }} relative flex flex-col overflow-hidden"
    data-reveal
    data-testimonials
    data-autoplay="{{ 'true' if (auto_play and total_count > 1) else 'false' }}"
    data-speed="{{ speed * 1000 }}"
  >
    <div class="theme-container flex flex-col gap-[var(--section-py)]">
      {% with eyebrow=eye, heading=head, align="center", eyebrow_style="pill", ornament="star" %}
        {% include 'components/shared/section-header.jinja' %}
      {% endwith %}

      {% if total_count > 0 %}
        <div
          class="testimonials__wrapper relative w-full"
          role="region"
          aria-roledescription="carousel"
          aria-label="{{ head if head else _('Testimonials') }}"
          data-reveal-item="stage"
        >
          <div class="testimonials__stage" data-testimonials-stage>
            <div class="testimonials__glow" aria-hidden="true"></div>
            {% for item in valid_testimonials %}
              {% set author_name = item.author | default('', true) %}
              {% set name_parts = author_name.split(' ') %}
              {% set initials = (name_parts[0][0] if name_parts[0] else '') ~ (name_parts[1][0] if (name_parts|length > 1 and name_parts[1]) else '') %}

              <div
                class="testimonials__slide {{ 'is-active' if loop.first }}"
                role="group"
                aria-roledescription="slide"
                aria-label="{{ loop.index }} {{ _('of') }} {{ total_count }}"
                {% if not loop.first %}aria-hidden="true" tabindex="-1"{% endif %}
                data-testimonial-slide="{{ loop.index0 }}"
              >
                <div class="testimonials__stars">
                  {% with rating=item.rating %}
                    {% include 'components/ui/rating-stars.jinja' %}
                  {% endwith %}
                </div>

                <div class="testimonials__quote-area">
                  <span class="testimonials__watermark" aria-hidden="true">“</span>
                  <blockquote class="testimonials__quote">{{ item.quote }}</blockquote>
                </div>

                <div class="testimonials__author">
                  <span class="testimonials__author-line" aria-hidden="true"></span>

                  <div
                    class="testimonials__avatar {{ 'testimonials__avatar--initials' if not (item.image or item.image_mobile) }}"
                  >
                    {% if item.image or item.image_mobile %}
                      {% with image=item.image, image_mobile=item.image_mobile, alt=author_name, class="w-full h-full object-cover", w_mobile=112, w_desktop=112, sizes="56px" %}
                        {% include 'components/shared/responsive-image.jinja' %}
                      {% endwith %}
                    {% else %}
                      {{ initials if initials else '✦' }}
                    {% endif %}
                  </div>

                  <div class="testimonials__author-info">
                    <span class="testimonials__name">{{ author_name }}</span>
                    {% if item.role %}
                      <span class="testimonials__role">{{ item.role }}</span>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}

            {% if total_count > 1 %}
              <button
                type="button"
                class="testimonials__arrow testimonials__arrow--prev focus-visible:outline-2 focus-visible:outline-[var(--color-ring)]"
                data-testimonials-prev
                aria-label="{{ _('Previous slide') }}"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  class="h-5 w-5 rtl:rotate-180"
                  aria-hidden="true"
                >
                  <path d="M15 18l-6-6 6-6" />
                </svg>
              </button>

              <button
                type="button"
                class="testimonials__arrow testimonials__arrow--next focus-visible:outline-2 focus-visible:outline-[var(--color-ring)]"
                data-testimonials-next
                aria-label="{{ _('Next slide') }}"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  class="h-5 w-5 rtl:rotate-180"
                  aria-hidden="true"
                >
                  <path d="M9 18l6-6-6-6" />
                </svg>
              </button>
            {% endif %}
          </div>

          {% if total_count > 1 %}
            <div class="testimonials__footer">
              <div class="testimonials__progress-bar">
                <div
                  class="testimonials__progress-fill"
                  data-testimonials-progress
                  style="transform: scaleX({{ 1 / total_count if total_count > 0 else 1 }});"
                ></div>
              </div>

              <div class="testimonials__counter" aria-live="polite" aria-atomic="true">
                <span data-testimonials-current>01</span>
                <span>/</span>
                <span>{{ '%02d' % total_count }}</span>
              </div>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}
