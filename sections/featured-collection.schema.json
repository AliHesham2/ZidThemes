{
  "template": "featured-collection",
  "name": {
    "ar": "منتجات مختارة",
    "en": "Featured collection"
  },
  "icon": "shopping-bag-line",
  "settings": [
    {
      "id": "eyebrow",
      "type": "text",
      "label": { "ar": "العنوان الفرعي", "en": "Eyebrow" },
      "default": ""
    },
    {
      "id": "heading",
      "type": "text",
      "label": { "ar": "العنوان الرئيسي", "en": "Heading" },
      "default": ""
    },
    {
      "id": "products",
      "type": "products",
      "label": { "ar": "المنتجات", "en": "Products" }
    },
    {
      "id": "products_to_show",
      "type": "range",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": { "ar": "أقصى عدد للمنتجات المعروضة", "en": "Maximum products to show" }
    },
    {
      "id": "layout",
      "type": "select",
      "options": [
        { "value": "grid", "label": { "ar": "شبكة", "en": "Grid" } },
        { "value": "carousel", "label": { "ar": "شريط أفقي", "en": "Horizontal carousel" } }
      ],
      "default": "grid",
      "label": { "ar": "نمط العرض", "en": "Layout pattern" }
    },
    {
      "id": "columns_desktop",
      "type": "range",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": { "ar": "عدد الأعمدة على سطح المكتب", "en": "Number of columns on desktop" }
    },
    {
      "id": "show_view_all",
      "type": "checkbox",
      "label": {
        "ar": "إظهار رابط \"عرض الكل\" عند وجود منتجات إضافية",
        "en": "Show \"View all\" link when there are more products"
      },
      "default": true
    },
    {
      "id": "view_all_label",
      "type": "text",
      "label": { "ar": "نص رابط عرض الكل", "en": "View all label" },
      "default": ""
    },
    {
      "id": "show_on_desktop",
      "type": "checkbox",
      "label": { "ar": "إظهار على سطح المكتب", "en": "Show on desktop" },
      "default": true
    },
    {
      "id": "show_on_mobile",
      "type": "checkbox",
      "label": { "ar": "إظهار على الجوال", "en": "Show on mobile" },
      "default": true
    }
  ]
}
