{
  "template": "editorial",
  "name": {
    "ar": "قصة تحريرية",
    "en": "Editorial"
  },
  "icon": "article-line",
  "settings": [
    {
      "id": "eyebrow",
      "type": "text",
      "label": { "ar": "العنوان الفرعي", "en": "Eyebrow" },
      "default": ""
    },
    {
      "id": "heading",
      "type": "text",
      "label": { "ar": "العنوان الرئيسي", "en": "Heading" },
      "default": ""
    },
    {
      "id": "show_on_desktop",
      "type": "checkbox",
      "label": { "ar": "إظهار على سطح المكتب", "en": "Show on desktop" },
      "default": true
    },
    {
      "id": "show_on_mobile",
      "type": "checkbox",
      "label": { "ar": "إظهار على الجوال", "en": "Show on mobile" },
      "default": true
    },
    {
      "id": "rows",
      "type": "list",
      "label": { "ar": "الصفوف التحريرية", "en": "Editorial rows" },
      "max_items": 5,
      "settings": [
        {
          "id": "is_visible",
          "type": "checkbox",
          "label": { "ar": "إظهار الصف", "en": "Show row" },
          "default": true
        },
        {
          "id": "image",
          "type": "image",
          "label": { "ar": "صورة الخلفية (سطح المكتب)", "en": "Card photo (desktop)" }
        },
        {
          "id": "image_mobile",
          "type": "image",
          "label": { "ar": "صورة الخلفية (الجوال)", "en": "Card photo (mobile)" }
        },
        {
          "id": "image_alt",
          "type": "text",
          "label": { "ar": "الوصف البديل للصورة", "en": "Image alt text" },
          "default": ""
        },
        {
          "id": "product_image",
          "type": "image",
          "label": { "ar": "صورة المنتج الشفافة (سطح المكتب)", "en": "Product PNG (desktop)" }
        },
        {
          "id": "product_image_mobile",
          "type": "image",
          "label": { "ar": "صورة المنتج الشفافة (الجوال)", "en": "Product PNG (mobile)" }
        },
        {
          "id": "accent",
          "type": "select",
          "label": { "ar": "لوحة الألوان", "en": "Artwork accent" },
          "options": [
            { "value": "rose", "label": { "ar": "وردي", "en": "Rose" } },
            { "value": "gold", "label": { "ar": "ذهبي", "en": "Gold" } },
            { "value": "lavender", "label": { "ar": "خزامى", "en": "Lavender" } },
            { "value": "mint", "label": { "ar": "نعناعي", "en": "Mint" } }
          ],
          "default": "rose"
        },
        {
          "id": "layout",
          "type": "select",
          "label": { "ar": "تخطيط الصف", "en": "Layout" },
          "options": [
            { "value": "image_first", "label": { "ar": "الصورة أولاً", "en": "Image first" } },
            { "value": "text_first", "label": { "ar": "النص أولاً", "en": "Text first" } }
          ],
          "default": "image_first"
        },
        {
          "id": "eyebrow",
          "type": "text",
          "label": { "ar": "العنوان الفرعي للصف", "en": "Row eyebrow" },
          "default": ""
        },
        {
          "id": "heading",
          "type": "text",
          "label": { "ar": "عنوان الصف", "en": "Row heading" },
          "default": ""
        },
        {
          "id": "text",
          "type": "richtext",
          "label": { "ar": "نص الصف", "en": "Row text" },
          "default": ""
        },
        {
          "id": "cta_label",
          "type": "text",
          "label": { "ar": "نص الزر", "en": "CTA label" },
          "default": ""
        },
        {
          "id": "cta_url",
          "type": "url",
          "label": { "ar": "رابط الزر", "en": "CTA URL" }
        }
      ]
    }
  ]
}
