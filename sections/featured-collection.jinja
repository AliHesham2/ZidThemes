{% set is_show_desktop = safeget(settings, "show_on_desktop", true) %}
{% set is_show_mobile  = safeget(settings, "show_on_mobile",  true) %}

{% set eye = safeget(settings, "eyebrow", "") %}
{% set head = safeget(settings, "heading", "") %}
{% set prods_obj = safeget(settings, "products", none) %}
{% set prods_list = prods_obj.results if (prods_obj and prods_obj.results is defined and prods_obj.results) else [] %}
{% set view_all_url = prods_obj.url if (prods_obj and prods_obj.url is defined and prods_obj.url) else url_for('list_products') %}
{% set cols_dt = safeget(settings, "columns_desktop", 4) | int %}
{% set show_va = safeget(settings, "show_view_all", true) %}
{% set va_label = safeget(settings, "view_all_label", "") %}
{% set va_text = va_label if va_label else _("View all") %}
{% set prod_count = prods_list | length %}

<section
  section-id="{{ sectionId }}"
  class="featured-collection {{ 'hidden lg:flex' if is_show_desktop and not is_show_mobile }} {{ 'flex lg:hidden' if is_show_mobile and not is_show_desktop }} {{ 'hidden' if not is_show_desktop and not is_show_mobile }} flex flex-col"
  data-reveal
>
  <div class="theme-container flex flex-col gap-[var(--section-py)]">
    {% with eyebrow=eye, heading=head, align="center", link_label=(va_text if show_va else ""), link_url=(view_all_url if show_va else ""), link_placement="below" %}
      {% include 'components/shared/section-header.jinja' %}
    {% endwith %}

    {% if prod_count > 0 %}
      <div class="slider" data-slider>
        <ul
          class="slider__track featured-collection__grid fc-grid--cols-{{ cols_dt }}"
          data-slider-track
          data-count="{{ prod_count }}"
        >
          {% for p in prods_list %}
            <li class="slider__item featured-collection__item">
              {% with product=p, index=loop.index0 %}
                {% include 'components/products/product-card.jinja' %}
              {% endwith %}
            </li>
          {% endfor %}
        </ul>
        {% include 'components/ui/slider-controls.jinja' %}
      </div>
    {% else %}
      <div class="featured-collection__placeholders pointer-events-none" aria-hidden="true">
        <ul class="featured-collection__grid fc-grid--cols-{{ cols_dt }}">
          {% for i in range(cols_dt) %}
            <li class="featured-collection__item">
              {% with product=none, index=loop.index0 %}
                {% include 'components/products/product-card.jinja' %}
              {% endwith %}
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </div>
</section>
